<!-- MainWindow.xaml -->
<Window x:Class="karacsonyGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Angyalka – Karácsonyi készletkezelő"
        Width="1120"
        Height="800"
        MinWidth="970"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFF1F6FA"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ==================== SZÍNEK ==================== -->
        <Color x:Key="DarkColor">#FF102E42</Color>
        <Color x:Key="BlueColor">#FF17618A</Color>
        <Color x:Key="LightBlueColor">#FF2793BD</Color>
        <Color x:Key="GreenColor">#FF168154</Color>
        <Color x:Key="OrangeColor">#FFD8861C</Color>
        <Color x:Key="RedColor">#FFC53731</Color>
        <Color x:Key="PurpleColor">#FF7356B6</Color>
        <Color x:Key="TextColor">#FF172B38</Color>
        <Color x:Key="MutedColor">#FF687D8A</Color>
        <Color x:Key="BorderColor">#FFD3E2EA</Color>

        <SolidColorBrush x:Key="DarkBrush" Color="{StaticResource DarkColor}"/>
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}"/>
        <SolidColorBrush x:Key="LightBlueBrush" Color="{StaticResource LightBlueColor}"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}"/>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="{StaticResource BorderColor}"/>

        <!-- ==================== EGYEDI SCROLLBAR ==================== -->
        <!--
            FONTOS:
            Csak EZ az egy ScrollBar Style szerepeljen a teljes XAML-ben.
            A C# közvetlenül a Thumb.Background értékét változtatja.
        -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.Thumb>
                                    <Thumb Background="#FF8FB4C7"
                                           BorderThickness="0"
                                           Margin="2,4">

                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="0"
                                                        CornerRadius="6">

                                                    <Border.Effect>
                                                        <DropShadowEffect ShadowDepth="1"
                                                                          BlurRadius="5"
                                                                          Opacity="0.28"
                                                                          Color="#FF173B50"/>
                                                    </Border.Effect>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="thumbBorder"
                                                                Property="Opacity"
                                                                Value="0.82"/>
                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                             Value="True">
                                                        <Setter TargetName="thumbBorder"
                                                                Property="Opacity"
                                                                Value="0.68"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== SCROLLVIEWER ==================== -->
        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Margin="1,5,1,5"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== GOMBOK ==================== -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="3"
                                                  BlurRadius="8"
                                                  Opacity="0.23"
                                                  Color="#FF12384C"/>
                            </Border.Effect>

                            <Grid>
                                <Rectangle RadiusX="9"
                                           RadiusY="9"
                                           IsHitTestVisible="False"
                                           Opacity="0.18">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="0.60"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder"
                                        Property="Background"
                                        Value="{StaticResource LightBlueBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder"
                                        Property="Background"
                                        Value="#FFB5C6D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
            <Setter Property="Background" Value="#FFE4F2F8"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource RedBrush}"/>
        </Style>

        <!-- ==================== TEXTBOX ==================== -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#FFFCFEFF"/>
            <Setter Property="BorderBrush" Value="#FFBFD1DC"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="textBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="textBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource LightBlueBrush}"/>
                                <Setter TargetName="textBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                                <Setter TargetName="textBorder"
                                        Property="Background"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="textBorder"
                                        Property="BorderBrush"
                                        Value="#FF76ACC8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== COMBOBOX ==================== -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#FFFCFEFF"/>
            <Setter Property="BorderBrush" Value="#FFBFD1DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ==================== LISTBOX ==================== -->
        <Style TargetType="ListBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#FFF9FCFE"/>
            <Setter Property="BorderBrush" Value="#FFD6E4EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="185"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ==================== FEJLÉC ==================== -->
        <Border Grid.Row="0"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop Color="#FF102E42" Offset="0"/>
                    <GradientStop Color="#FF14536F" Offset="0.48"/>
                    <GradientStop Color="#FF2A95B2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Ellipse Width="300"
                         Height="300"
                         Margin="-145,-190,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Fill="#18FFFFFF"/>

                <Ellipse Width="350"
                         Height="350"
                         Margin="0,-190,-130,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="#11FFFFFF"/>

                <Grid Margin="50,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="51"
                                    Height="51"
                                    Margin="0,0,15,0"
                                    Background="#26FFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="25.5">
                                <TextBlock Text="❄"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="28"
                                           Foreground="White"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Angyalka nyilvántartás"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Margin="1,5,0,0"
                                           Text="Karácsonyi készletkezelő rendszer"
                                           FontSize="14"
                                           Foreground="#FFD8EFF8"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Width="530"
                                Height="1"
                                Margin="0,17,0,0"
                                HorizontalAlignment="Left"
                                Background="#45FFFFFF"/>

                        <TextBlock Margin="2,10,0,0"
                                   Text="Rögzítsd a napi adatokat, és kövesd az elkészített, eladott és készleten maradt angyalkákat."
                                   FontSize="13"
                                   Foreground="#D9FFFFFF"/>
                    </StackPanel>

                    <Grid Grid.Column="1"
                          Width="230"
                          Height="135"
                          Margin="25,0,0,0"
                          VerticalAlignment="Center">
                        <Border Width="119"
                                Height="119"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#20FFFFFF"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                CornerRadius="59.5">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="3"
                                                  BlurRadius="15"
                                                  Opacity="0.26"
                                                  Color="#FF071E2B"/>
                            </Border.Effect>

                            <TextBlock Text="🎄"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="66"/>
                        </Border>

                        <TextBlock Margin="2,13,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Text="✦"
                                   FontSize="25"
                                   Foreground="#FFFFDE8C"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== FŐ TARTALOM ==================== -->
        <ScrollViewer x:Name="foScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="FoScrollViewer_ScrollChanged">

            <Grid Margin="50,32,50,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- NAPI ADATFELVITEL -->
                <Border Grid.Row="0"
                        Padding="29"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4"
                                          BlurRadius="18"
                                          Opacity="0.10"
                                          Color="#FF17384B"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="-29,-29,-29,0"
                                CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop Color="#FF17618A" Offset="0"/>
                                    <GradientStop Color="#FF2B9ABD" Offset="0.55"/>
                                    <GradientStop Color="#FF8BD1DF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Grid.Row="1"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="50"
                                    Height="50"
                                    Margin="0,0,15,0"
                                    Background="#FFE3F3FA"
                                    BorderBrush="#FFC8E3EE"
                                    BorderThickness="1"
                                    CornerRadius="25">
                                <TextBlock Text="✚"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BlueBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Napi zárás rögzítése"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Margin="0,5,0,0"
                                           Text="Add meg az angyalkák elkészített és eladott mennyiségét."
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Padding="13,7"
                                    VerticalAlignment="Center"
                                    Background="#FFF0EBFA"
                                    BorderBrush="#FFE1D8F2"
                                    BorderThickness="1"
                                    CornerRadius="15">
                                <TextBlock Text="✦ Napi adatlap"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PurpleBrush}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="1.22*"/>
                                <ColumnDefinition Width="1.22*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,24,0">
                                <TextBlock Margin="2,0,0,8"
                                           Text="▣  NAP SZÁMA"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <ComboBox x:Name="cmbNap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,24,0">
                                <TextBlock Margin="2,0,0,8"
                                           Text="✚  ELKÉSZÍTETT (DB)"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBox x:Name="txtKeszitett"
                                         Text="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,26,0">
                                <TextBlock Margin="2,0,0,8"
                                           Text="↗  ELADOTT (DB)"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBox x:Name="txtEladott"
                                         Text="0"/>
                            </StackPanel>

                            <Button x:Name="btnHozzaad"
                                    Grid.Column="3"
                                    Width="145"
                                    Margin="0,27,0,0"
                                    Content="✚  Hozzáadás"
                                    Click="BtnHozzaad_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ÜZENET -->
                <Border x:Name="borderUzenet"
                        Grid.Row="1"
                        Margin="0,18,0,0"
                        Padding="16,13"
                        Background="#FFFDEBEB"
                        BorderBrush="#FFE79B97"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="26"
                                Height="26"
                                VerticalAlignment="Center"
                                Background="#FFFFD7D5"
                                CornerRadius="13">
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource RedBrush}"/>
                        </Border>

                        <TextBlock x:Name="txtUzenet"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource RedBrush}"/>
                    </Grid>
                </Border>

                <!-- STATISZTIKAI KÁRTYÁK -->
                <Grid Grid.Row="2"
                      Margin="0,26,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="21"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3"
                                              BlurRadius="13"
                                              Opacity="0.09"
                                              Color="#FF17384B"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource GreenBrush}"
                                    CornerRadius="12"/>

                            <StackPanel Grid.Column="1"
                                        Margin="15,0,0,0">
                                <TextBlock Text="AKTUÁLIS KÉSZLET"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBlock x:Name="txtAktualisKeszlet"
                                           Margin="0,8,0,0"
                                           Text="0 db"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GreenBrush}"/>

                                <TextBlock Margin="0,4,0,0"
                                           Text="Raktáron lévő angyalkák"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Width="57"
                                    Height="57"
                                    Background="#FFE0F5EA"
                                    CornerRadius="28.5">
                                <TextBlock Text="✓"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GreenBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="21"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3"
                                              BlurRadius="13"
                                              Opacity="0.09"
                                              Color="#FF17384B"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource BlueBrush}"
                                    CornerRadius="12"/>

                            <StackPanel Grid.Column="1"
                                        Margin="15,0,0,0">
                                <TextBlock Text="ÖSSZES ELKÉSZÜLT"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBlock x:Name="txtOsszesKeszitett"
                                           Margin="0,8,0,0"
                                           Text="0 db"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BlueBrush}"/>

                                <TextBlock Margin="0,4,0,0"
                                           Text="Elkészített angyalkák"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Width="57"
                                    Height="57"
                                    Background="#FFE2F3FA"
                                    CornerRadius="28.5">
                                <TextBlock Text="✚"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BlueBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4"
                            Padding="21"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="3"
                                              BlurRadius="13"
                                              Opacity="0.09"
                                              Color="#FF17384B"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource OrangeBrush}"
                                    CornerRadius="12"/>

                            <StackPanel Grid.Column="1"
                                        Margin="15,0,0,0">
                                <TextBlock Text="ÖSSZES ELADOTT"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBlock x:Name="txtOsszesEladott"
                                           Margin="0,8,0,0"
                                           Text="0 db"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource OrangeBrush}"/>

                                <TextBlock Margin="0,4,0,0"
                                           Text="Értékesített angyalkák"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Width="57"
                                    Height="57"
                                    Background="#FFFFF0D8"
                                    CornerRadius="28.5">
                                <TextBlock Text="↗"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource OrangeBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- GYORS FUNKCIÓK -->
                <Border Grid.Row="3"
                        Margin="0,0,0,24"
                        Padding="22"
                        Background="#FFFDFEFF"
                        BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="47"
                                Height="47"
                                Margin="0,0,14,0"
                                Background="#FFF0EBFA"
                                BorderBrush="#FFE3D8F4"
                                BorderThickness="1"
                                CornerRadius="23.5">
                            <TextBlock Text="✦"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="23"
                                       Foreground="{StaticResource PurpleBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Gyors funkciók"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Margin="0,3,0,0"
                                       Text="Statisztikák, lista és megjelenés kezelése."
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Margin="13,0,7,0"
                                Width="130"
                                Content="Mai nap"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnMaiNap_Click"/>

                        <Button Grid.Column="3"
                                Margin="7,0"
                                Width="145"
                                Content="Minta adat"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnMintaAdat_Click"/>

                        <Button Grid.Column="4"
                                Margin="7,0"
                                Width="140"
                                Content="Összegzés"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnOsszegzes_Click"/>

                        <Button Grid.Column="5"
                                Margin="7,0,0,0"
                                Width="120"
                                Content="Téma"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnTema_Click"/>
                    </Grid>
                </Border>

                <!-- ELŐZMÉNYLISTA -->
                <Border Grid.Row="4"
                        MinHeight="290"
                        Padding="27"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4"
                                          BlurRadius="18"
                                          Opacity="0.10"
                                          Color="#FF17384B"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="21"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="13"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="-27,-27,-27,0"
                                CornerRadius="18,18,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop Color="#FF7356B6" Offset="0"/>
                                    <GradientStop Color="#FF2D95BC" Offset="0.55"/>
                                    <GradientStop Color="#FF87CDD9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Grid.Row="1"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="39"
                                        Height="39"
                                        Margin="0,0,12,0"
                                        Background="#FFF0EBFA"
                                        CornerRadius="19.5">
                                    <TextBlock Text="☷"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="20"
                                               Foreground="{StaticResource PurpleBrush}"/>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Rögzített napi adatok"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>

                                    <TextBlock Margin="0,3,0,0"
                                               Text="Korábbi bejegyzések és a nap végén megmaradt készlet."
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Width="140"
                                    Margin="15,2,0,0"
                                    Content="⌫  Lista törlése"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="BtnTorles_Click"/>
                        </Grid>

                        <Border Grid.Row="3"
                                Padding="15,11"
                                Background="#FFEAF4F9"
                                BorderBrush="#FFD5E7EF"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="NAP"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BlueBrush}"/>

                                <TextBlock Grid.Column="1"
                                           Text="ELKÉSZÍTETT"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BlueBrush}"/>

                                <TextBlock Grid.Column="2"
                                           Text="ELADOTT"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BlueBrush}"/>

                                <TextBlock Grid.Column="3"
                                           Text="NAP VÉGI KÉSZLET"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BlueBrush}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="5">
                            <ListBox x:Name="lstEredmenyek"
                                     IsHitTestVisible="False"
                                     FontSize="14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="15,12"
                                                Background="#FFFCFDFE"
                                                BorderBrush="#FFE0E9EF"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding NapSzoveg}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BlueBrush}"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KeszitettSzoveg}"
                                                           Foreground="{StaticResource TextBrush}"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding EladottSzoveg}"
                                                           Foreground="{StaticResource TextBrush}"/>

                                                <Border Grid.Column="3"
                                                        Padding="9,3"
                                                        HorizontalAlignment="Left"
                                                        Background="#FFE1F5EA"
                                                        CornerRadius="9">
                                                    <TextBlock Text="{Binding KeszletSzoveg}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GreenBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="txtUresLista"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <Border Width="80"
                                        Height="80"
                                        HorizontalAlignment="Center"
                                        Background="#FFE7F4FA"
                                        BorderBrush="#FFD0E7F1"
                                        BorderThickness="1"
                                        CornerRadius="40">
                                    <TextBlock Text="❄"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="39"/>
                                </Border>

                                <TextBlock Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           Text="Még nincs rögzített napi adat."
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"/>

                                <TextBlock Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           Text="Az első napot a felső űrlapon rögzítheted."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="7"
                                Padding="13,10"
                                Background="#FFF7FBFD"
                                BorderBrush="#FFDCEAF1"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="23"
                                        Height="23"
                                        Margin="0,0,9,0"
                                        Background="#FFE0F1FA"
                                        CornerRadius="11.5">
                                    <TextBlock Text="i"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BlueBrush}"/>
                                </Border>

                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="Hozzáadás után a kiválasztott nap és az annál korábbi napok nem választhatók ki újra."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- LÁBLÉC -->
        <Border Grid.Row="2"
                Background="#FFEAF3F8"
                BorderBrush="#FFD4E1E8"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="50,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            Margin="0,0,9,0"
                            Background="#FFDDEEF7"
                            CornerRadius="13">
                        <TextBlock Text="❄"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"/>
                    </Border>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Karácsonyi díszek • Angyalka készletkezelő"/>
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Padding="14,6"
                        VerticalAlignment="Center"
                        Background="#FFDCEEF7"
                        BorderBrush="#FFC8E0EC"
                        BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock x:Name="txtNapokSzama"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BlueBrush}"
                               Text="Rögzített napok: 0"/>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>